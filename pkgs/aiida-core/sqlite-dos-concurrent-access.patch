 REPOSITORY_UUID_KEY = 'repository|uuid'
 
+BUSY_TIMEOUT_MILLISECONDS = 60000
+"""Number of milliseconds a connection waits for a lock before giving up.
+
+SQLite serialises writers, so a busy timeout is what turns "another process is
+writing" from an error into a wait.  The DB-API default is five seconds, which
+is a normal duration for a daemon worker's transaction and so is routinely
+exceeded on a loaded machine.
+"""
+
+
+def sqlite_concurrent_access(dbapi_connection: Any, _: Any) -> None:
+    """Configure a connection for access by more than one process.
+
+    A profile's database is opened by the daemon workers and by every ``verdi``
+    invocation at the same time, which the two SQLite defaults do not support:
+
+    * The default journal mode is ``DELETE``, a rollback journal, under which a
+      reader holding ``SHARED`` blocks a writer from taking ``EXCLUSIVE``.  In
+      WAL mode readers and a writer proceed concurrently, which is the access
+      pattern a daemon plus a client actually has.
+    * The default busy timeout is five seconds.  See
+      ``BUSY_TIMEOUT_MILLISECONDS``.
+
+    ``journal_mode`` is recorded in the database header and so persists to every
+    later connection, including ones opened by another process or an older
+    AiiDA.  It cannot be set inside a transaction, which is why this runs from
+    the ``connect`` event: the DB-API connection is fresh there, and pysqlite
+    defers ``BEGIN`` until the first DML, so none is open.  On a filesystem that
+    cannot support WAL -- a network mount, which has no shared memory -- SQLite
+    leaves the mode as it was and reports it in the returned row rather than
+    raising, so a profile on such a mount keeps working with the old behaviour.
+    """
+    cursor = dbapi_connection.cursor()
+    try:
+        cursor.execute('PRAGMA journal_mode=WAL;')
+        cursor.execute(f'PRAGMA busy_timeout={BUSY_TIMEOUT_MILLISECONDS};')
+    finally:
+        cursor.close()
+
+
+def create_sqla_engine_concurrent(filepath: str | Path, **kwargs) -> Engine:
+    """Return an engine for a profile database, configured for concurrent access.
+
+    Every engine opened on the profile database goes through here rather than
+    through :func:`~aiida.storage.sqlite_zip.utils.create_sqla_engine` directly,
+    so that the migrator and the session factory cannot disagree.  That matters
+    because the two pragmas have different lifetimes: ``journal_mode`` is
+    persistent, so whichever engine opens the file first decides it, while
+    ``busy_timeout`` is per connection and has to be set on all of them.
+    """
+    engine = create_sqla_engine(filepath, **kwargs)
+    event.listen(engine, 'connect', sqlite_concurrent_access)
+    return engine
+
 
 class SqliteDosMigrator(PsqlDosMigrator):
     """Class for validating and migrating `sqlite_dos` storage instances.
