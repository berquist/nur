--- a/test/conftest.py
+++ b/test/conftest.py
@@ -266,3 +266,63 @@
 
     if torch.cuda.is_available():
         torch.cuda.empty_cache()
+
+
+# ==============================================================================
+# CUDA Gating
+# ==============================================================================
+#
+# Added downstream.  About a thousand tests in this suite ask for a CUDA device,
+# and only some of them check for one first: test/neighbors/conftest.py marks
+# items `gpu` by name but only under its own directory, and
+# test/test_segment_ops_jax.py skips itself when JAX has no GPU.  Everything
+# else fails on a CPU-only machine -- "Invalid device identifier: cuda:0" from
+# warp, "Torch not compiled with CUDA enabled" from torch, or a JAX FFI handler
+# that was never registered for the Host platform.
+#
+# pytest_runtest_setup rather than a collection-time marker, deliberately: it
+# runs per test rather than racing the -m filter for hook order, and it reports
+# a skip with a reason instead of a silent deselection.
+
+_CUDA_ONLY_DIRECTORIES = ("bindings/jax",)
+
+_WARP_HAS_CUDA: bool | None = None
+
+
+def _warp_has_cuda() -> bool:
+    """Whether warp can see a CUDA device.  Asked once per session."""
+    global _WARP_HAS_CUDA
+    if _WARP_HAS_CUDA is None:
+        import warp as wp
+
+        _WARP_HAS_CUDA = bool(wp.is_cuda_available())
+    return _WARP_HAS_CUDA
+
+
+def _item_needs_cuda(item: pytest.Item) -> bool:
+    """Whether a test asks for a CUDA device by name, by parameter or by path."""
+    name = item.name.lower()
+    if "cuda" in name or "gpu" in name:
+        return True
+
+    # Catches parametrisations whose values are objects rather than strings --
+    # `parametrize("device", [torch.device("cpu"), torch.device("cuda:0")])`
+    # gets index-based ids, so the device never appears in the test name.
+    callspec = getattr(item, "callspec", None)
+    if callspec is not None and any(
+        "cuda" in str(value).lower() for value in callspec.params.values()
+    ):
+        return True
+
+    # Every JAX binding goes through warp's JAX FFI, whose handlers are
+    # registered for the CUDA platform alone; test/test_segment_ops_jax.py says
+    # so itself, with "JAX segment-op bindings require a CUDA-capable JAX
+    # device".  The other JAX modules do not check, and fail instead.
+    item_path = _item_path(item)
+    return any(directory in item_path for directory in _CUDA_ONLY_DIRECTORIES)
+
+
+def pytest_runtest_setup(item: pytest.Item) -> None:
+    """Skip a test that needs a CUDA device when the machine has none."""
+    if _item_needs_cuda(item) and not _warp_has_cuda():
+        pytest.skip("requires a CUDA-capable device")
