         interpolation_nodes=4,
         full_neighbor_list=True,
-        prefactor=1.0,
     ).to(device=device, dtype=VIRIAL_DTYPE)
     charges_col = charges.unsqueeze(1)
     cell_2d = cell.squeeze(0) if cell.dim() == 3 else cell
