diff -ruN pyrr-pristine/pyrr/objects/base.py pyrr-patched/pyrr/objects/base.py
--- a/pyrr/objects/base.py	2024-11-03 02:49:24.000000000 -0500
+++ b/pyrr/objects/base.py	2026-08-26 12:36:20.583561772 -0400
@@ -21,6 +21,25 @@
         obj.shape = cls._shape
         return obj
 
+    def __array_wrap__(self, array, context=None, return_scalar=False):
+        # Boolean ufunc results must not come back as pyrr objects.
+        #
+        # These classes overload | and ^ as the dot and cross products, and
+        # numpy's own code combines comparison masks with those operators --
+        # isclose() computes
+        #
+        #     (less_equal(abs(x-y), atol + rtol*abs(y)) & isfinite(y)) | (x == y)
+        #
+        # Because ufunc output preserves the subclass, less_equal() returns a
+        # boolean Vector3/Quaternion, and pyrr's __eq__ returns a plain Python
+        # bool -- so that final | dispatches into the dot product with a bool
+        # argument and raises. Returning a plain ndarray for boolean results
+        # keeps arithmetic subclass propagation, which the rest of pyrr relies
+        # on, while letting numpy's internals work on masks as masks.
+        if array.dtype == bool:
+            return np.asarray(array)
+        return super().__array_wrap__(array, context, return_scalar)
+
     def _unsupported_type(self, method, other):
         raise ValueError('Cannot {} a {} to a {}'.format(method, type(other).__name__, type(self).__name__))
 
