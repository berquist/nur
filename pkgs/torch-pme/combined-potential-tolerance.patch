+    # difference is a couple of ulp of the *operands* while `rtol * |result|`
+    # has collapsed with the result.  A fixed `atol = 3e-16` then fails on an
+    # error that is correct rounding.
+    scale = float(
+        torch.max(
+            torch.abs(weights[0] * ipl_1_from_dist)
+            + torch.abs(weights[1] * ipl_2_from_dist)
+        )
+    )
+    atol = 8 * machine_epsilon * scale
